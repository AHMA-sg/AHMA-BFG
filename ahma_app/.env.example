# Ultravox API
ULTRAVOX_API_KEY=your_ultravox_api_key_here
ULTRAVOX_BASE_URL=https://api.ultravox.ai/api

# AHMA Backend (Flask)
BACKEND_API_URL=http://localhost:5001
BACKEND_API_KEY=your_backend_key_here
# On Vercel, set BACKEND_API_URL to your deployed AHMA backend, for example:
# BACKEND_API_URL=https://your-ahma-backend.vercel.app

# Ultravox RAG Corpus IDs
CORPUS_ID_CAREGIVER_GUIDES=your_corpus_id_here

# Firebase (for later - optional for POC)
# FIREBASE_API_KEY=
# FIREBASE_PROJECT_ID=

WEBHOOK_SECRET=default_secret
WEBHOOK_port=8081

# AHMA Profile API (backend_v2 on :5002, started by ./setup_and_run.sh --with-profile-backend)
PROFILE_API_URL=http://localhost:5002
